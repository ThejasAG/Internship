# ==============================================================================
# InternPilot AI - Environment Configuration Template
# NOTE: Copy this file to .env and configure values before starting services.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PROJECT_NAME="InternPilot AI API"
API_V1_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=internpilot
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@localhost:5432/internpilot
# Sync database URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/internpilot

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
